{
  "manifest_version": 3,
  "name": "PH Videos Auto-Play",
  "version": "1.2",
  "description": "In Programming Hero course, this extension automatically plays the next video in the module when the current one finishes.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PH Videos Auto-Play",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://web.programming-hero.com/*"],
      "js": ["content.js"]
    }
  ]
}