{
  "manifest_version": 3,
  "name": "Course Auto-Player",
  "version": "1.1",
  "description": "Automatically clicks the 'Next' button when a video finishes playing.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto-Player Settings"
  },
  "content_scripts": [
    {
      "matches": ["https://web.programming-hero.com/*"],
      "js": ["content.js"]
    }
  ]
}